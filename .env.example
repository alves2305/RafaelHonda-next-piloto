NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima

# URL pública do sistema. Em desenvolvimento, use http://localhost:3000.
# Na Vercel, use a URL final com https://
APP_URL=http://localhost:3000

# InfiniteTag da conta InfinitePay, sem o símbolo $
INFINITEPAY_HANDLE=seu-handle

# Somente no servidor. Nunca use prefixo NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sua-chave-secreta-sb_secret
# Alternativa para projetos com chave legada:
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Pix direto para a conta configurada. Use preferencialmente uma chave aleatoria.
PIX_KEY=sua-chave-pix
PIX_RECEIVER_NAME=SEU NOME
PIX_RECEIVER_CITY=IRECE
PIX_PAYMENT_WHATSAPP=5574999999999
